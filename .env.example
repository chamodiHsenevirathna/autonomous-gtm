# Local development only. No secrets belong in this repository.
GTM_DATABASE_URL=postgresql://gtm:gtm_local_dev_only@127.0.0.1:5433/gtm
GTM_TEST_DATABASE_URL=postgresql://gtm:gtm_local_dev_only@127.0.0.1:5433/gtm_test
# Model mode: replay | mock | live. Live calls are DISABLED unless ALL of these are set.
GTM_LLM_MODE=mock
GTM_ALLOW_LIVE=0
GTM_LIVE_BUDGET_USD=0
# ANTHROPIC_API_KEY is read only from the environment, never from files.
